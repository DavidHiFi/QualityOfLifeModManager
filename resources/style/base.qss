/* LanLauncher Qt - folha de estilo base (tokenizada).
   Nao escreva cores fixas aqui: os tokens @TOKEN@ sao substituidos por
   Theme::apply() com a paleta do tema escolhido.
   Temas: Nocturne (padrao), Classic Things Escuro, Classic Things Claro. */

* { outline: none; }

QWidget {
    background-color: @BG@;
    color: @TEXT@;
    font-family: @FONT@;
    font-size: 10pt;
}

QLabel { background: transparent; }
QMainWindow, QDialog { background-color: @BG@; }

QToolTip {
    background-color: @TOOLTIP_BG@;
    color: @TEXT@;
    border: 1px solid @LINE@;
    border-radius: @R_SM@;
    padding: 5px 8px;
}

/* ================= Barra lateral ================= */
#Sidebar {
    background-color: @SIDEBAR_BG@;
    border-right: 1px solid @LINE_SOFT@;
}

#SidebarTitle {
    color: @TEXT_STRONG@;
    font-size: 12.5pt;
    font-weight: 600;
    letter-spacing: 0.2px;
}

#SidebarSubtitle { color: @TEXT_FAINT@; font-size: 8.5pt; }

#NavSection {
    color: @TEXT_FAINT@;
    font-size: 7.5pt;
    font-weight: 700;
    letter-spacing: 1.8px;
    padding: 12px 10px 5px 10px;
}

#NavRule {
    background-color: @LINE_SOFT@;
    border: none;
    max-height: 1px;
    min-height: 1px;
}

#SidebarButton {
    text-align: left;
    padding: 9px 12px;
    border: 1px solid transparent;
    border-left: 2px solid transparent;
    border-radius: @R@;
    color: @NAV_TEXT@;
    background-color: transparent;
}

#SidebarButton:hover {
    background-color: @SURFACE_HI@;
    color: @TEXT_STRONG@;
}

#SidebarButton:checked {
    background-color: @TINT2@;
    border-left: 2px solid @ACCENT@;
    color: @ON_SELECT@;
    font-weight: 600;
}

#SidebarButton:pressed { background-color: @BTN_PRESS@; }

#GameNav {
    text-align: left;
    border: 1px solid transparent;
    border-left: 2px solid transparent;
    border-radius: @R@;
    background: transparent;
    color: @NAV_TEXT@;
    padding: 6px 8px;
}
#GameNav:hover { background: @SURFACE_HI@; }
#GameNav:checked {
    background: @TINT1@;
    border: 1px solid @LINE@;
    border-left: 2px solid @ACCENT@;
    color: @ON_SELECT@;
    font-weight: 600;
}

#SidebarFooter { background: transparent; }
#SidebarTitle, #SidebarSubtitle, #NavSection { background: transparent; }
#GamesNavBox, #GamesNavHead { background: transparent; }
#GameEditButton {
    background: transparent;
    border: none;
    border-radius: 5px;
    padding: 0;
}
#GameEditButton:hover { background: @TINT1@; }
#GameEditButton:checked {
    background: @OK@;
}

#GameNavTag {
    color: @ACCENT_SOFT@;
    font-size: 7.5pt;
    font-weight: 700;
    letter-spacing: 1.8px;
}

#GameNavName {
    color: @TEXT@;
    font-size: 10pt;
    font-weight: 500;
}

/* ================= Cabecalho de pagina ================= */
#HeaderBar {
    background-color: qlineargradient(x1:0, y1:0, x2:0, y2:1,
        stop:0 @HEADER_TOP@, stop:1 @HEADER_BOT@);
    border-bottom: 1px solid @LINE_SOFT@;
}

#PageKicker {
    color: @ACCENT_SOFT@;
    font-size: 7.5pt;
    font-weight: 700;
    letter-spacing: 2.4px;
}

#PageTitle {
    font-size: 15pt;
    font-weight: 500;
    color: @TEXT_STRONG@;
}

#PageSubtitle { color: @TEXT_DIM@; font-size: 9pt; }

#VersionBadge {
    color: @TEXT_DIM@;
    font-size: 8.5pt;
    padding: 3px 9px;
    border: 1px solid @LINE@;
    border-radius: @R@;
}
QPushButton#CreditLink {
    color: @ACCENT_SOFT@;
    background: transparent;
    border: 1px solid @LINE_STRONG@;
    border-radius: @R@;
    padding: 3px 10px;
    font-size: 8.5pt;
    font-weight: 600;
    min-height: 0;
}
QPushButton#CreditLink:hover {
    background-color: @BTN@;
    color: @TEXT_STRONG@;
    border-color: @ACCENT@;
}

/* ================= Cartoes ================= */
#Card {
    background-color: qlineargradient(x1:0, y1:0, x2:0, y2:1,
        stop:0 @SURFACE@, stop:1 @SURFACE_2@);
    border: 1px solid @LINE_CARD@;
    border-radius: @R@;
}

#CardHead {
    background: transparent;
    border: none;
    border-bottom: 1px solid @LINE_CARD@;
}

#CardTitle {
    color: @TEXT_STRONG@;
    font-size: 10.5pt;
    font-weight: 600;
}

#CardKicker {
    color: @ACCENT_SOFT@;
    font-size: 7.5pt;
    font-weight: 700;
    letter-spacing: 2.2px;
}

#CardDesc, #MutedHint { color: @TEXT_DIM@; font-size: 9pt; font-weight: 400; }
#FieldLabel { color: @TEXT_DIM@; font-size: 9pt; }

QGroupBox {
    background-color: @SURFACE@;
    border: 1px solid @LINE_CARD@;
    border-radius: @R@;
    margin-top: 12px;
    padding: 14px 12px 10px 12px;
    font-weight: 600;
    color: @TEXT_STRONG@;
}

QGroupBox::title {
    subcontrol-origin: margin;
    left: 10px;
    padding: 0 6px;
    color: @ACCENT_SOFT@;
}

/* ================= Campos ================= */
QLineEdit, QPlainTextEdit, QTextEdit {
    background-color: @FIELD@;
    border: 1px solid @LINE@;
    border-radius: @R@;
    padding: 8px 11px;
    color: @TEXT@;
    selection-background-color: @ACCENT@;
    selection-color: @ACCENT_TEXT@;
}

QLineEdit:hover, QPlainTextEdit:hover { border: 1px solid @LINE_STRONG@; }
QLineEdit:focus, QPlainTextEdit:focus, QTextEdit:focus { border: 1px solid @ACCENT@; }
QLineEdit:disabled, QPlainTextEdit:disabled { color: @DISABLED_TEXT@; background-color: @FIELD_DISABLED@; }

QLineEdit#MonoField {
    font-family: "Cascadia Mono", "Consolas", monospace;
    font-size: 12pt;
    font-weight: 600;
    padding: 11px 12px;
    color: @ACCENT_SOFT@;
}

QComboBox {
    background-color: @FIELD@;
    border: 1px solid @LINE@;
    border-radius: @R@;
    padding: 7px 11px;
    min-height: 18px;
}
QComboBox:hover { border: 1px solid @LINE_STRONG@; }
QComboBox:focus, QComboBox:on { border: 1px solid @ACCENT@; }
QComboBox::drop-down { border: none; width: 22px; }
QComboBox::down-arrow {
    image: none;
    border-left: 4px solid transparent;
    border-right: 4px solid transparent;
    border-top: 5px solid @TEXT_DIM@;
    width: 0; height: 0;
    margin-right: 9px;
}

QComboBox QAbstractItemView {
    background-color: @SURFACE@;
    border: 1px solid @LINE@;
    border-radius: @R@;
    padding: 4px;
    selection-background-color: @TINT2@;
    selection-color: @ON_SELECT@;
    outline: none;
}

QListWidget, QListView {
    background-color: @FIELD@;
    border: 1px solid @LINE@;
    border-radius: @R@;
    padding: 5px;
}

QListWidget::item {
    padding: 8px 9px;
    border: 1px solid transparent;
    border-left: 2px solid transparent;
    border-radius: @R_SM@;
    color: @TEXT@;
}

QListWidget::item:selected {
    background-color: @TINT1@;
    border: 1px solid @TINT_BORDER@;
    border-left: 2px solid @ACCENT@;
    color: @ON_SELECT@;
}

QListWidget::item:hover:!selected { background-color: @SURFACE_HI@; }

/* ================= Botoes ================= */
QPushButton {
    background-color: @BTN@;
    border: 1px solid @BTN_LINE@;
    border-radius: @R@;
    padding: 8px 15px;
    color: @BTN_TEXT@;
}

QPushButton:hover { background-color: @BTN_HOVER@; border: 1px solid @LINE_STRONG@; }
QPushButton:pressed { background-color: @BTN_PRESS@; }
QPushButton:disabled { color: @DISABLED_TEXT@; background-color: @DISABLED_BG@; border: 1px solid @DISABLED_LINE@; }

/* Acao primaria: contorno de destaque */
QPushButton#PrimaryButton, QPushButton[cssClass="primary"] {
    background-color: @TINT1@;
    color: @ACCENT_SOFT@;
    border: 1px solid @ACCENT@;
    font-weight: 600;
}
QPushButton#PrimaryButton:hover, QPushButton[cssClass="primary"]:hover {
    background-color: @TINT2@;
    color: @ON_SELECT@;
}
QPushButton#PrimaryButton:pressed, QPushButton[cssClass="primary"]:pressed {
    background-color: @TINT3@;
}
QPushButton#PrimaryButton:disabled, QPushButton[cssClass="primary"]:disabled {
    background-color: @DISABLED_BG@;
    border: 1px solid @DISABLED_LINE@;
    color: @DISABLED_TEXT@;
}

QPushButton[cssClass="ghost"] {
    background-color: transparent;
    border: 1px solid transparent;
    color: @TEXT_DIM@;
}
QPushButton[cssClass="ghost"]:hover { background-color: @BTN@; color: @TEXT_STRONG@; }
QPushButton[cssClass="ghost"]:pressed { background-color: @BTN_PRESS@; }

QPushButton#DangerButton, QPushButton[cssClass="danger"] {
    background-color: @DANGER_TINT@;
    border: 1px solid @DANGER_LINE@;
    color: @DANGER_TEXT@;
}
QPushButton#DangerButton:hover, QPushButton[cssClass="danger"]:hover {
    background-color: @DANGER_TINT2@;
    color: @DANGER_TEXT_HI@;
}

/* ================= Radio / Checkbox ================= */
QRadioButton, QCheckBox {
    spacing: 8px;
    padding: 4px 4px 4px 0;
    color: @TEXT@;
    background: transparent;
}
QRadioButton:hover, QCheckBox:hover { color: @TEXT_STRONG@; }

QRadioButton::indicator { width: 16px; height: 16px; }
QRadioButton::indicator {
    border-radius: @R_ROUND@;
    border: 2px solid @LINE_STRONG@;
    background: @FIELD@;
}
QRadioButton::indicator:hover { border: 2px solid @ACCENT@; }
QRadioButton::indicator:checked {
    border: 5px solid @ACCENT@;
    background-color: @FIELD@;
}
QRadioButton:checked { color: @TEXT_STRONG@; }

QCheckBox::indicator {
    width: 17px;
    height: 17px;
    border-radius: @R_XS@;
    border: 2px solid @LINE_STRONG@;
    background: @FIELD@;
}
QCheckBox::indicator:hover { border: 2px solid @ACCENT@; background: @SURFACE_HI@; }
QCheckBox::indicator:checked {
    border: 2px solid @ACCENT@;
    background-color: @ACCENT@;
    image: url(@CHECK_ICON@);
}
QCheckBox::indicator:checked:hover {
    background-color: @ACCENT_LIGHT@;
    border: 2px solid @ACCENT_LIGHT@;
}
QCheckBox::indicator:checked:pressed { background-color: @ACCENT_DARK@; }
QCheckBox::indicator:disabled { border: 2px solid @DISABLED_LINE@; background: @DISABLED_BG@; }
QCheckBox::indicator:checked:disabled { background-color: @DISABLED_LINE@; border: 2px solid @DISABLED_LINE@; }
QCheckBox:checked { color: @TEXT_STRONG@; }

/* ================= Abas ================= */
QTabWidget::pane { border: 1px solid @LINE_CARD@; border-radius: @R@; top: -1px; }
QTabBar::tab {
    background: transparent;
    color: @TEXT_DIM@;
    padding: 8px 16px;
    border-bottom: 2px solid transparent;
}
QTabBar::tab:selected { color: @TEXT_STRONG@; border-bottom: 2px solid @ACCENT@; }

/* ================= Rolagem ================= */
QScrollArea { border: none; background: transparent; }

QScrollBar:vertical { background: transparent; width: 10px; margin: 2px; }
QScrollBar::handle:vertical { background: @SCROLL@; border-radius: @R_XS@; min-height: 26px; }
QScrollBar::handle:vertical:hover { background: @SCROLL_HOVER@; }
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical { height: 0; }
QScrollBar::add-page, QScrollBar::sub-page { background: transparent; }

QScrollBar:horizontal { background: transparent; height: 10px; margin: 2px; }
QScrollBar::handle:horizontal { background: @SCROLL@; border-radius: @R_XS@; min-width: 26px; }
QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal { width: 0; }

/* ================= Progresso ================= */
QProgressBar {
    background-color: @FIELD@;
    border: 1px solid @LINE@;
    border-radius: @R@;
    text-align: center;
    color: @TEXT@;
    height: 16px;
}
QProgressBar::chunk {
    background-color: qlineargradient(x1:0, y1:0, x2:1, y2:0,
        stop:0 @ACCENT_DARK@, stop:1 @ACCENT_LIGHT@);
    border-radius: @R_XS@;
}

/* ================= Dialogos ================= */
QMessageBox { background-color: @SURFACE@; }
QLabel#DialogIcon { padding-right: 6px; }

/* ================= Pagina de jogo (hero) ================= */
#PlayPage { background: @BG_DEEP@; }

#HeroCode {
    color: @ACCENT_SOFT@;
    font-size: 10pt;
    font-weight: 700;
    letter-spacing: 3px;
}
#HeroTitle { color: @HERO_TEXT@; font-size: 26pt; font-weight: 600; }
#HeroSub { color: @HERO_SUB@; }
#HeroPath { color: @HERO_SUB@; font-size: 9pt; }

#PlayButton, #StopButton, #ClientGearButton {
    min-height: 48px;
    max-height: 48px;
    font-size: 11.5pt;
    font-weight: 700;
    padding: 0 28px;
}
#ClientGearButton {
    min-width: 48px;
    max-width: 48px;
    padding: 0;
}

/* LAN | Online segmented switch on the play page */
#SegmentButton {
    background: rgba(12,13,22,0.55);
    color: @HERO_SUB@;
    border: 1px solid rgba(255,255,255,0.18);
    padding: 0 16px;
    font-weight: 600;
}
#SegmentButton[segment="left"]  { border-top-left-radius: @R_SM@; border-bottom-left-radius: @R_SM@; border-right: none; }
#SegmentButton[segment="right"] { border-top-right-radius: @R_SM@; border-bottom-right-radius: @R_SM@; }
#SegmentButton:hover { color: @HERO_TEXT@; background: rgba(12,13,22,0.75); }
#SegmentButton:checked {
    background: @ACCENT@;
    color: @ACCENT_TEXT@;
    border-color: @ACCENT@;
}
#PlayPage QCheckBox[onArt="true"] { color: @HERO_SUB@; }
#PlayPage QCheckBox[onArt="true"]:checked { color: @HERO_TEXT@; }

#AboutColumn { background: transparent; }
#AboutLink { padding: 0 18px; font-weight: 600; }
#AboutCredit {
    color: @ACCENT_SOFT@;
    font-size: 13pt;
    font-weight: 600;
    qproperty-alignment: AlignCenter;
}
#AboutBody {
    color: @TEXT_DIM@;
    qproperty-alignment: AlignCenter;
}
#AboutBody, #AboutCredit {
    qproperty-alignment: AlignCenter;
}
#PlayPage #HeroTitle, #PlayPage #HeroSub, #PlayPage #HeroPath, #PlayPage #HeroCode {
    qproperty-alignment: AlignLeft;
}

/* ================= Setup wizard ================= */
#WizardHeader {
    background-color: qlineargradient(x1:0, y1:0, x2:0, y2:1,
        stop:0 @HEADER_TOP@, stop:1 @BG_DEEP@);
    border-bottom: 1px solid @LINE_SOFT@;
}
#WizardFooter { background-color: @BG_DEEP@; border-top: 1px solid @LINE_SOFT@; }
#WizardTitle { font-size: 15pt; font-weight: 500; color: @TEXT_STRONG@; }
#WizardSub { color: @TEXT_DIM@; font-size: 9pt; }
#WizardLead { font-size: 13pt; font-weight: 600; color: @TEXT_STRONG@; }
#WizardCard {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
        stop:0 @SURFACE@, stop:1 @SURFACE_2@);
    border: 1px solid @LINE_CARD@;
    border-radius: @R@;
}
#WizardNum { font-size: 15pt; font-weight: 700; color: @ACCENT_SOFT@; min-width: 34px; }
#WizardCardTitle { font-weight: 600; }
#WizardCardDesc { color: @TEXT_DIM@; }

/* ================= Home (catalogo de mods) ================= */
#HomePage, #HomeContent { background: @BG@; }

#HomeBar {
    background-color: qlineargradient(x1:0, y1:0, x2:0, y2:1,
        stop:0 @HEADER_TOP@, stop:1 @HEADER_BOT@);
    border-bottom: 1px solid @LINE_SOFT@;
}

/* --- filtros por jogo --- */
QPushButton#GameChip {
    background: transparent;
    border: 1px solid @LINE@;
    border-radius: @R@;
    padding: 6px 13px;
    color: @TEXT_DIM@;
    font-size: 9pt;
}
QPushButton#GameChip:hover { background-color: @SURFACE_HI@; color: @TEXT_STRONG@; }
QPushButton#GameChip:checked {
    background-color: @TINT1@;
    border: 1px solid @ACCENT@;
    color: @ON_SELECT@;
    font-weight: 600;
}

/* --- slider de destaques --- */
#HeroSlideTitle { color: @HERO_TEXT@; font-size: 21pt; font-weight: 600; }
#HeroSlideSummary { color: @HERO_SUB@; font-size: 10.5pt; }
#HeroSlideMeta { color: @HERO_SUB@; font-size: 8.5pt; }

QPushButton#HeroArrow {
    background-color: @SURFACE@;
    border: 1px solid @LINE@;
    border-radius: @R_ARROW@;
    color: @TEXT@;
    font-size: 15pt;
    padding: 0;
}
QPushButton#HeroArrow:hover { background-color: @TINT2@; border: 1px solid @ACCENT@; }
QPushButton#HeroArrow:pressed { background-color: @TINT3@; }

QPushButton#HeroDot {
    background-color: @SCROLL@;
    border: none;
    border-radius: @R_DOT@;
    padding: 0;
}
QPushButton#HeroDot:hover { background-color: @SCROLL_HOVER@; }
QPushButton#HeroDot:checked { background-color: @ACCENT@; }

/* --- secoes por jogo --- */
#SectionTitle { color: @TEXT_STRONG@; font-size: 12pt; font-weight: 500; }

/* --- card de mod --- */
#ModCard {
    background-color: qlineargradient(x1:0, y1:0, x2:0, y2:1,
        stop:0 @SURFACE@, stop:1 @SURFACE_2@);
    border: 1px solid @LINE_CARD@;
    border-radius: @R@;
}
#ModCard:hover { border: 1px solid @ACCENT@; background-color: @SURFACE_HI@; }

#ModCardTitle { color: @TEXT_STRONG@; font-size: 10pt; font-weight: 600; }
#ModCardInstalled { color: @OK@; font-size: 8.5pt; font-weight: 600; }
#ModCardUpdate { color: @WARN@; font-size: 8.5pt; font-weight: 600; }
#ModCardMeta { color: @TEXT_DIM@; font-size: 8.5pt; }
#ModTags { color: @ACCENT_SOFT@; font-size: 9pt; }
